rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // רק האוסף events, ורק בצורה שהאפליקציה כותבת. כל השאר חסום.
    match /events/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(
                         ['kind', 'place', 'washer', 'date', 'absent', 'suggested', 'createdAt'])
                    && request.resource.data.kind in ['wash', 'host', 'none']
                    && request.resource.data.date is string
                    && request.resource.data.date.size() == 10
                    && request.resource.data.createdAt is number
                    && (request.resource.data.washer == null
                        || request.resource.data.washer in ['נועה', 'נווה', 'אופק'])
                    && (request.resource.data.place == null
                        || request.resource.data.place in ['mom', 'dad']);
      allow delete: if true;
      allow update: if false;
    }
  }
}
